[Unit]
Description=DTwin dedicated Docker on the data disk
Requires=dtwin-containerd.service
After=dtwin-containerd.service network-online.target
Wants=network-online.target
RequiresMountsFor=/data/dtwin

[Service]
Type=notify
Environment=DOCKER_TMPDIR=/data/dtwin/tmp
ExecStartPre=/data/dtwin/bin/check-mount
ExecStart=/bin/sh -c 'exec /usr/bin/dockerd --config-file=/data/dtwin/config/daemon.json >>/data/dtwin/logs/dockerd.log 2>&1'
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=120
Delegate=yes
KillMode=process
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=0

[Install]
WantedBy=multi-user.target
