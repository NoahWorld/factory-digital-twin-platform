# Copy to /data/dtwin/config/.env with permissions 0600; generate fresh secrets.
# Pin the actual fetched image digests before starting services.
PUBLIC_ORIGIN=http://YOUR_SERVER:19080
POSTGRES_IMAGE=postgres:17-bookworm
VALKEY_IMAGE=valkey/valkey:8.1.3-alpine
STORAGE_IMAGE=chrislusf/seaweedfs:4.47
NGINX_IMAGE=nginx:stable-bookworm
BACKEND_IMAGE=dtwin/backend:REPLACE_WITH_MAIN_SHA
RELEASE_DIR=/data/dtwin/releases/REPLACE_WITH_RELEASE_ID
DATABASE_USER=twin
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
VALKEY_PASSWORD=REPLACE_WITH_RANDOM_SECRET
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
S3_BUCKET=factory-twin
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_SECRET
DEFAULT_TENANT=dtwin
ALLOWED_ORIGINS=http://YOUR_SERVER:19080
SECURE_COOKIE=false
RUNTIME_ALLOWED_ORIGINS=
