# Run node scripts/init-local.mjs to create local secrets. Do not commit .env.
# Optional ABSOLUTE path to the standalone Java repository; otherwise use its sibling directory.
# TWIN_BACKEND_DIR=/absolute/path/factory-digital-twin-backend
DATABASE_USER=twin
DATABASE_PASSWORD=replace-with-random-secret
VALKEY_PASSWORD=replace-with-random-secret
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret
S3_BUCKET=factory-twin
S3_PUBLIC_ENDPOINT=http://127.0.0.1:18333
BOOTSTRAP_TOKEN=replace-with-random-token
DEFAULT_TENANT=local
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:18080
SECURE_COOKIE=false
# Explicit scheme + host + port. Empty disables outbound collection.
RUNTIME_ALLOWED_ORIGINS=
