# Frontend only; do not put MinIO secrets or IoT login tokens in VITE_* variables.
VITE_PRODUCT_NAME="Kingdom 3D Vision"
# Development: /cloud; production default: /cloudPro/api.
# VITE_IOT_API_PREFIX=/cloudPro/api
VITE_IOT_HOME_PATH=/
VITE_IOT_LOGIN_PATH=/user/login
# Optional comma-separated public MinIO origins for signed downloads.
# Empty permits same-origin downloads only. HTTPS pages require HTTPS resources.
# VITE_IOT_RESOURCE_ORIGINS=https://files.example.com
# Development proxy target only (not included in the browser bundle).
# IOT_DEV_API_TARGET=http://127.0.0.1:18848
