# This file remains on the server. Never place real values in the project package.
BOOTSTRAP_TOKEN=
SESSION_TTL_HOURS=24
RUNTIME_POLLING_ENABLED=false
# Exact host:port entries. Example for the local mock: 127.0.0.1:8790
RUNTIME_ALLOWED_HOSTS=
