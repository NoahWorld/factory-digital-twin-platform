    "db:migrate:local": "wrangler d1 migrations apply factory-digital-twin-config --local",
    "db:migrate:remote": "wrangler d1 migrations apply factory-digital-twin-config --remote"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.22.0"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0"
  }
}
