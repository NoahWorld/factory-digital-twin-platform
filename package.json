{
  "name": "factory-digital-twin-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Factory digital twin delivery platform with 2D and 3D dashboards.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:mock": "node scripts/mock-device-server.mjs",
    "dev:web": "pnpm --filter @factory-twin/web dev",
    "dev:api": "pnpm --filter @factory-twin/api dev",
    "start:runtime": "pnpm --filter @factory-twin/runtime start",
    "smoke:runtime": "node scripts/runtime-api-smoke-test.mjs",
    "test:newpower": "playwright test --reporter=line",
    "migrate:newpower": "node scripts/migrate-newpower.mjs",
    "build": "pnpm --filter @factory-twin/web build && pnpm --filter @factory-twin/api build && pnpm --filter @factory-twin/runtime build",
    "check": "pnpm --recursive run check"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/ws": "8.18.1",
    "aedes": "1.1.2",
    "fflate": "0.8.3",
    "ws": "8.21.3"
  }
}
